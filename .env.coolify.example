# Coolify environment variables
API_KEY=replace-with-a-long-random-secret
POSTGRES_DB=ocrllm
POSTGRES_USER=ocrllm
POSTGRES_PASSWORD=replace-with-a-long-random-password
MAX_UPLOAD_MB=20
OCR_QUEUE_CONCURRENCY=1
OCR_MAX_PAGES=50
OCR_PAGE_CONCURRENCY=1
OCR_UPSCALE_MIN_LONG_SIDE=2000
OCR_UPSCALE_MAX_FACTOR=4
VLM_ENABLED=true
VLM_MODEL=scb10x/typhoon-ocr1.5-3b
VLM_MODE=selective
VLM_SELECTIVE_MIN_CONFIDENCE=0.88
VLM_SELECTIVE_MIN_CHARS=80
VLM_NUM_CTX=8192
VLM_NUM_PREDICT=4096
VLM_KEEP_ALIVE=-1
REVIEW_MIN_SIMILARITY=0.6
MISSING_MAX_SIMILARITY=0.4
LLM_ENABLED=true
LLM_MODEL=scb10x/typhoon2.5-qwen3-4b
LLM_NUM_CTX=16384
LLM_NUM_PREDICT=4096
LLM_KEEP_ALIVE=-1
LLM_TIMEOUT_SECONDS=120
LLM_LAZY_LOAD=true
