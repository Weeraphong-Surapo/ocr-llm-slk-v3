# Coolify environment variables
API_KEY=replace-with-a-long-random-secret
POSTGRES_DB=ocrllm
POSTGRES_USER=ocrllm
POSTGRES_PASSWORD=replace-with-a-long-random-password
MAX_UPLOAD_MB=20
OCR_QUEUE_CONCURRENCY=1
OCR_MAX_PAGES=50
OCR_UPSCALE_MIN_LONG_SIDE=2000
OCR_UPSCALE_MAX_FACTOR=4
VLM_ENABLED=true
VLM_MODEL=scb10x/typhoon-ocr1.5-3b
REVIEW_MIN_SIMILARITY=0.6
